# PR review/sandbox only. Checkout must stay OFF.
HOST=127.0.0.1
PORT=3000
TABO_CHECKOUT_ENABLED=0
# Public Pixel ID; blank disables browser tracking. No access token is needed.
# Production hostname only; test-mode and historical purchases are never reported.
TABO_META_PIXEL_ID=
TABO_PERSISTENT_STORAGE_READY=0
TABO_ORIGINALS_VERIFIED=0
SUPABASE_URL=https://your-isolated-project.supabase.co
# SUPABASE_SECRET_KEY=server-only; store privately
# Independent random key >=32 characters; keep stable when rotating Supabase.
# TABO_SESSION_BINDING_KEY=store privately
# TABO_ADMIN_KEY=store privately
TABO_PUBLIC_URL=https://your-isolated-sandbox.example
# AutoSEO publishes only to its dedicated new tables. Keep the shared key private.
# AUTOSEO_WEBHOOK_SECRET=store privately; match the token in AutoSEO
AUTOSEO_REQUIRE_SIGNATURE=0
# Downloaded image files are cached here and backed by durable database copies.
# AUTOSEO_IMAGE_CACHE_DIR=/tmp/tabo-autoseo-images
# Empty trusts the TCP peer only. Verify exact ingress CIDRs before setting.
TABO_TRUSTED_PROXY_CIDRS=
TABO_PAYMENT_PROVIDER=kashier
KASHIER_MODE=test
# KASHIER_MERCHANT_ID=MID-TEST-000
# KASHIER_TEST_PAYMENT_API_KEY=store privately
# KASHIER_TEST_SECRET_KEY=store privately
# KASHIER_LIVE_PAYMENT_API_KEY=separate credential; unused in test mode
# KASHIER_LIVE_SECRET_KEY=separate credential; unused in test mode
# USD storefront prices are converted to EGP before creating new Kashier sessions.
# Only actual charge currencies need merchant capability confirmation.
KASHIER_CURRENCIES=EGP
KASHIER_VERIFIED_CURRENCIES=
KASHIER_ALLOWED_METHODS=card
KASHIER_VERIFIED_METHODS=
TABO_USD_CAPABILITY_VERIFIED=0
# Paymob is TEST ONLY; live mode is rejected.
PAYMOB_MODE=test
# PAYMOB_TEST_SECRET_KEY=sk_test_... or egy_sk_test_..., store privately
# PAYMOB_TEST_PUBLIC_KEY=pk_test_... or egy_pk_test_..., store privately
# PAYMOB_TEST_HMAC_SECRET=store privately
# PAYMOB_TEST_EGP_METHOD_ID=your confirmed TEST integration
PAYMOB_CURRENCIES=EGP
PAYMOB_VERIFIED_CURRENCIES=

# Optional PayPal. This does not replace TABO_PAYMENT_PROVIDER=kashier.
# Keep disabled until real Sandbox validation and merchant capability checks.
TABO_PAYPAL_ENABLED=0
TABO_PAYPAL_CAPABILITY_VERIFIED=0
TABO_PAYPAL_LIVE_APPROVED=0
TABO_PAYPAL_SCHEMA_READY=0
PAYPAL_MODE=test
# Only an isolated test service may set TABO_ENV=paypal-sandbox.
# PAYPAL_SANDBOX_CLIENT_ID=store privately in Render
# PAYPAL_SANDBOX_CLIENT_SECRET=store privately in Render
# PAYPAL_SANDBOX_MERCHANT_ID=the Sandbox seller's merchant account ID
# PAYPAL_SANDBOX_WEBHOOK_ID=the webhook ID for the same Sandbox REST app
# PAYPAL_LIVE_CLIENT_ID=separate live credentials; never commit
# PAYPAL_LIVE_CLIENT_SECRET=store privately in Render
# PAYPAL_LIVE_MERCHANT_ID=confirmed live seller merchant account ID
# PAYPAL_LIVE_WEBHOOK_ID=the webhook ID for the same live REST app

# Optional paid-order confirmation email. Keep off until sender/DNS and schema are verified.
TABO_RECEIPTS_ENABLED=0
TABO_RECEIPTS_SCHEMA_READY=0
TABO_RECEIPT_SENDER_VERIFIED=0
TABO_RECEIPT_FROM=
RESEND_API_KEY=

# Email-verified assistance, additive service-only schema required.
TABO_ORDER_HELP_ENABLED=0
TABO_ORDER_HELP_SCHEMA_READY=0
# Actual GA4 web-stream ID only. Empty means disabled. No retroactive purchase events.
TABO_GA4_ID=
TABO_GA4_PURCHASE_SINCE=
