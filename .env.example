# Preview only: keep checkout off until private storage, books and sandbox payment work.
HOST=0.0.0.0
PORT=3000
TABO_CHECKOUT_ENABLED=0
TABO_PERSISTENT_STORAGE_READY=0
TABO_ORIGINALS_VERIFIED=0
SUPABASE_URL=https://kiglrbfgvjpauugkjuoi.supabase.co
# SUPABASE_SECRET_KEY=<store privately in Render settings>
# TABO_ADMIN_KEY=<store privately in Render settings>
# Choose exactly one provider: paymob or kashier.
TABO_PAYMENT_PROVIDER=paymob
# Kashier live settings. Keep both keys only in Render's Environment page.
# KASHIER_MODE=live
# KASHIER_MERCHANT_ID=MID-00000-000
# KASHIER_PAYMENT_API_KEY=<rotate and store privately in Render settings>
# KASHIER_SECRET_KEY=<store privately in Render settings>
# KASHIER_ALLOWED_METHODS=card,wallet
# Enable USD only after Kashier confirms it for this live merchant.
# KASHIER_CURRENCIES=EGP
# PAYMOB_SECRET_KEY=<store privately in Render settings>
# PAYMOB_PUBLIC_KEY=<store privately in Render settings>
# PAYMOB_HMAC_SECRET=<store privately in Render settings>
# PAYMOB_EGP_METHOD_ID=5932821
# PAYMOB_USD_METHOD_ID=<Paymob USD payment method ID>
# PAYMOB_PAYMENT_METHODS_JSON={"USD":123456}
# TABO_PUBLIC_URL=https://your-domain.example
